<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Winche.Console</RootNamespace>
    <AssemblyName>Winche.Console</AssemblyName>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>
  <ItemGroup>
    <!-- Built SPA assets are embedded so the library is a single self-contained package. -->
    <EmbeddedResource Include="wwwroot\**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Winche.Console.Tests" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.0" />
    <PackageReference Include="Winche.Database" Version="11.1.0" />
    <!-- 3.1.0: rule functions and the text syntax the rules editor uses (RuleText). -->
    <PackageReference Include="Winche.Rules" Version="4.1.0" />
    <PackageReference Include="Winche.Storage" Version="9.1.0" />
    <PackageReference Include="Winche.Auth.AspNetCore" Version="1.0.0" />
    <PackageReference Include="Winche.Core" Version="1.0.0" />
    <PackageReference Include="Winche.Core.AspNetCore" Version="1.0.0" />
    <PackageReference Include="Winche.Webhooks" Version="1.0.0" />
    <PackageReference Include="Winche.Functions" Version="1.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
  </ItemGroup>
</Project>
